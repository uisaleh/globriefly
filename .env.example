# Copy to .env for local testing. In production these go in GitHub → Settings → Secrets and variables → Actions.

SITE_URL=https://globriefly.com
FACEBOOK_PAGE_URL=https://facebook.com/yourpage
NEXT_PUBLIC_NEWSLETTER_ACTION=
# Contact form → your Gmail (free): https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Writing (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional free fallback writer: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=

# Optional free photo sources (Wikimedia Commons needs no key)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Facebook Page
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_LINK_IN=comment

# Behaviour
MAX_STORIES_PER_RUN=3
REQUIRE_REVIEW=false
DRY_RUN=false
